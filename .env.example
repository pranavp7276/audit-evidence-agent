# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=audit
POSTGRES_PASSWORD=audit
POSTGRES_DB=audit
POSTGRES_PORT=5432
DATABASE_URL=postgresql://audit:audit@localhost:5432/audit

# Models (Sarvam API). Get the key from the project owner; never commit .env.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
LLM_REASONING_MODEL=deepseekv4.1-flash-1017
LLM_CHAT_MODEL=sarvam-105b-conversations
DECISION_MODEL=sarvam-prism

# Hard cap for any single SQL statement the agent runs (ms)
AGENT_SQL_TIMEOUT_MS=30000
