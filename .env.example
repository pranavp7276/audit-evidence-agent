# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=audit
POSTGRES_PASSWORD=audit
POSTGRES_DB=audit
POSTGRES_PORT=5432
DATABASE_URL=postgresql://audit:audit@localhost:5432/audit

# Model access for the agent
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6

# Hard cap for any single SQL statement the agent runs (ms)
AGENT_SQL_TIMEOUT_MS=30000
